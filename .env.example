# Environment Variables
# Copy this file to .env and fill in your values

# App Configuration
NODE_ENV=development
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:8081

# Server
PORT=3000
HOST=localhost

# JWT Secrets
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wari_app
DB_USER=postgres
DB_PASSWORD=postgres
DB_URL=postgresql://postgres:postgres@localhost:5432/wari_app

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Mobile Money Providers
CINETPAY_API_KEY=your-cinetpay-api-key
CINETPAY_SITE_ID=your-cinetpay-site-id
ORANGE_MONEY_API_KEY=your-orange-money-api-key
MTN_MONEY_API_KEY=your-mtn-money-api-key
MOOV_MONEY_API_KEY=your-moov-money-api-key
WAVE_API_KEY=your-wave-api-key

# Firebase (Notifications)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_MESSAGING_SENDER_ID=your-firebase-sender-id
FIREBASE_APP_ID=your-firebase-app-id

# Twilio (SMS)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@wari-app.local

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Security
BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=900000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:8081,http://localhost:3000

# Features
ENABLE_BIOMETRIC_AUTH=true
ENABLE_OFFLINE_MODE=true
ENABLE_ANALYTICS=true
