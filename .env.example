# Application
NODE_ENV=development
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:8081

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wari_db
DB_USER=postgres
DB_PASSWORD=your_secure_password

# Redis
REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key
ENCRYPTION_KEY=your_32_character_encryption_key

# Firebase (Push Notifications)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_MESSAGING_SENDER_ID=your_firebase_sender_id
FIREBASE_APP_ID=your_firebase_app_id

# Mobile Money Providers (Côte d'Ivoire)
ORANGE_MONEY_API_KEY=your_orange_money_key
ORANGE_MONEY_SECRET=your_orange_money_secret
MTN_MONEY_API_KEY=your_mtn_money_key
MTN_MONEY_SECRET=your_mtn_money_secret
MOOV_MONEY_API_KEY=your_moov_money_key
MOOV_MONEY_SECRET=your_moov_money_secret
WAVE_MONEY_API_KEY=your_wave_money_key
WAVE_MONEY_SECRET=your_wave_money_secret

# SMS Service
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# Compliance
COMPLIANCE_MODE=strict
LOG_TRANSACTIONS=true
AML_CHECK_ENABLED=true

# App Features
BIOMETRIC_ENABLED=true
OFFLINE_SYNC_ENABLED=true
VOICE_COMMANDS_ENABLED=true
ANALYTICS_ENABLED=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
