{
  "name": "wari-app",
  "version": "1.0.0",
  "description": "Envoyer et recevoir de l'argent via Mobile Money - Send and receive money via mobile money with sub-2% fees, biometric security, and full accessibility",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "build": "tsc",
    "backend:dev": "node --loader ts-node/esm backend/server.ts",
    "backend:prod": "node backend/dist/server.js",
    "backend:build": "tsc --project tsconfig.backend.json",
    "db:migrate": "ts-node backend/migrations/run.ts",
    "db:seed": "ts-node backend/seeds/seed.ts",
    "security:audit": "npm audit",
    "accessibility:check": "pa11y-ci"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-native": "^0.73.0",
    "expo": "^50.0.0",
    "expo-biometric": "^2.3.0",
    "react-native-paper": "^5.11.0",
    "react-native-gesture-handler": "^2.14.0",
    "react-native-reanimated": "^3.6.0",
    "@react-navigation/native": "^6.1.10",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/stack": "^6.3.21",
    "redux": "^4.2.1",
    "react-redux": "^8.1.3",
    "@reduxjs/toolkit": "^1.9.7",
    "axios": "^1.6.2",
    "react-hook-form": "^7.48.0",
    "zod": "^3.22.4",
    "@hookform/resolvers": "^3.3.4",
    "crypto-js": "^4.2.0",
    "libsodium.js": "^0.7.11",
    "react-native-encrypted-storage": "^4.0.3",
    "react-native-sqlite-storage": "^6.0.0",
    "firebase": "^10.7.0",
    "expo-notifications": "^0.27.0",
    "expo-device": "^5.8.0",
    "react-native-sound": "^0.11.2",
    "expo-speech": "^11.5.0",
    "react-native-voice": "^3.2.7",
    "recharts": "^2.10.3",
    "date-fns": "^2.30.0",
    "uuid": "^9.0.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.1.2",
    "bcryptjs": "^2.4.3",
    "pg": "^8.11.3",
    "sequelize": "^6.35.2",
    "redis": "^4.6.12",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-native": "^0.73.0",
    "@types/node": "^20.10.5",
    "@types/jest": "^29.5.11",
    "typescript": "^5.3.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "prettier": "^3.1.1",
    "pa11y-ci": "^3.1.1",
    "expo-cli": "^6.3.10",
    "@testing-library/react-native": "^12.4.0",
    "@testing-library/jest-native": "^5.4.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "mobile-money",
    "money-transfer",
    "africa",
    "cote-d-ivoire",
    "fintech",
    "biometric",
    "security",
    "accessibility"
  ]
}
