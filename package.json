{
  "name": "wari-app",
  "version": "1.0.0",
  "description": "Send and receive money via Mobile Money",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "backend:dev": "ts-node backend/server.ts",
    "backend:build": "tsc --project tsconfig.backend.json",
    "backend:prod": "node dist/backend/server.js",
    "lint": "eslint src backend --ext .ts,.tsx",
    "lint:fix": "eslint src backend --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "security:audit": "npm audit",
    "accessibility:check": "axe-core --exit",
    "db:migrate": "knex migrate:latest",
    "db:seed": "knex seed:run",
    "db:rollback": "knex migrate:rollback",
    "format": "prettier --write src backend",
    "prebuild": "npm run lint && npm run type-check && npm test"
  },
  "keywords": [
    "mobile-money",
    "transfer",
    "payment",
    "africa",
    "wallet",
    "financial-inclusion"
  ],
  "author": "mrgohou",
  "license": "MIT",
  "dependencies": {
    "@reduxjs/toolkit": "^1.9.7",
    "axios": "^1.6.5",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "expo": "^49.0.0",
    "expo-crypto": "^12.4.2",
    "expo-local-authentication": "^13.4.1",
    "expo-notifications": "^0.20.1",
    "expo-secure-store": "^12.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.1.2",
    "react": "^18.2.0",
    "react-hook-form": "^7.49.0",
    "react-native": "^0.73.0",
    "react-native-paper": "^5.11.0",
    "react-redux": "^8.1.3",
    "redux": "^4.2.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@jest/globals": "^29.7.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react": "^14.1.2",
    "@testing-library/react-native": "^12.4.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.10",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.45",
    "@types/react-native": "^0.73.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "jest-expo": "^49.0.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
